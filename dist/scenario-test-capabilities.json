{
  "schema": "scenario-test-capabilities",
  "version": "0.5.26",
  "contractVersion": 6,
  "assertions": {
    "operators": {
      "exists": {
        "description": "字段存在且非 null/空串（exists: true），或不存在（exists: false）",
        "valueType": "boolean"
      },
      "equals": {
        "description": "实际值与期望值 JSON 深比较相等",
        "valueType": "any"
      },
      "notEquals": {
        "description": "实际值与期望值 JSON 深比较后取反",
        "valueType": "any"
      },
      "includes": {
        "description": "数组包含期望项，或字符串包含期望子串",
        "valueType": "any"
      },
      "each": {
        "description": "数组逐项断言：实际值必须是数组，expected 为子断言定义对象或其数组，对每个元素套用子断言（子断言 path 相对元素自身，期望值支持模板变量）；任一元素任一子断言失败则整体失败，空数组恒通过，非数组实际值直接失败",
        "valueType": "assertion"
      },
      "matches": {
        "description": "正则表达式匹配字符串化后的实际值",
        "valueType": "string"
      },
      "oneOf": {
        "description": "实际值属于期望候选数组之一（深比较）",
        "valueType": "array"
      },
      "startsWith": {
        "description": "字符串化后的实际值以期望值开头（大小写敏感；null/undefined 实际值视为空串）",
        "valueType": "string"
      },
      "endsWith": {
        "description": "字符串化后的实际值以期望值结尾（大小写敏感；null/undefined 实际值视为空串）",
        "valueType": "string"
      },
      "length": {
        "description": "数组元素个数 / 字符串字符数 / 对象键数等于期望值；非容器类型（number/boolean/null）直接失败",
        "valueType": "finiteNumber"
      },
      "gt": {
        "description": "实际值大于期望值",
        "valueType": "finiteNumber"
      },
      "gte": {
        "description": "实际值大于等于期望值",
        "valueType": "finiteNumber"
      },
      "lt": {
        "description": "实际值小于期望值",
        "valueType": "finiteNumber"
      },
      "lte": {
        "description": "实际值小于等于期望值",
        "valueType": "finiteNumber"
      }
    },
    "metaKeys": [
      "name",
      "path",
      "from",
      "target",
      "header",
      "implicit"
    ],
    "targets": [
      "status",
      "duration"
    ],
    "numericOperators": [
      "gt",
      "gte",
      "lt",
      "lte"
    ]
  },
  "when": {
    "sources": [
      "vars"
    ],
    "note": "when 对象形式只允许 from: \"vars\"；非对象形式（模板字符串/布尔）保持真值语义"
  },
  "extract": {
    "from": [
      "body",
      "headers",
      "bodyText",
      "response"
    ],
    "required": "boolean",
    "note": "required: true 且路径不存在时当前步骤失败；默认缺失产生 warning（不含响应内容），变量为 undefined"
  },
  "reservedVars": [
    "runId",
    "runNo"
  ],
  "generatedVars": {
    "types": [
      "timestamp",
      "uuidHex",
      "md5",
      "signature",
      "idcard",
      "luhn",
      "phone",
      "uscc",
      "uuid",
      "enum"
    ]
  },
  "globals": {
    "types": [
      "header",
      "cookie",
      "query"
    ],
    "note": "全局参数支持 header / cookie / query 三种类型，步骤显式声明或 URL 已有同名参数优先"
  },
  "config": {
    "scenarioItemKeys": [
      "id",
      "name",
      "url",
      "manual"
    ],
    "environmentKeys": [
      "key",
      "name",
      "baseUrl",
      "globals"
    ],
    "variableKeys": [
      "name",
      "label",
      "env",
      "required",
      "defaultValue"
    ],
    "manual": {
      "type": "boolean",
      "note": "manual: true 表示场景需要人工准备数据或写数据，--all 默认排除，--scenario <id> 可显式执行"
    }
  },
  "scenario": {
    "keys": [
      "name",
      "steps",
      "vars",
      "envVars",
      "generatedVars",
      "failurePolicy"
    ],
    "stepKeys": [
      "name",
      "method",
      "path",
      "params",
      "request",
      "status",
      "assertions",
      "extract",
      "when",
      "retryUntil",
      "timeoutMs",
      "saveResponseAs",
      "adapter"
    ],
    "failurePolicies": [
      "stop",
      "continue"
    ]
  },
  "cli": {
    "commands": [
      "run",
      "serve",
      "init",
      "capabilities",
      "doctor"
    ],
    "options": {
      "config": {
        "kind": "value",
        "description": "场景配置文件"
      },
      "env": {
        "kind": "value",
        "description": "配置中的环境 key"
      },
      "base-url": {
        "kind": "value",
        "description": "临时覆盖 Base URL"
      },
      "scenario": {
        "kind": "value",
        "description": "执行指定场景（可执行 manual:true 场景）"
      },
      "port": {
        "kind": "value",
        "description": "浏览器服务端口，默认 4300"
      },
      "project": {
        "kind": "value",
        "description": "init 目标项目根目录"
      },
      "dir": {
        "kind": "value",
        "description": "init 场景测试目录名"
      },
      "library-url": {
        "kind": "value",
        "description": "init 运行时副本下载目录（CLI/UMD/d.ts/capabilities，默认 GitHub Tag dist）"
      },
      "all": {
        "kind": "flag",
        "description": "执行配置中的全部自动场景（默认排除 manual:true）"
      },
      "force": {
        "kind": "flag",
        "description": "init 覆盖已有文件（目标目录已存在时可交互选择）"
      },
      "no-input": {
        "kind": "flag",
        "description": "init 非交互：目录已存在时按 keep（保留配置与场景，仅刷新 AI 规则和运行时副本）"
      },
      "fail-on-skip": {
        "kind": "flag",
        "description": "存在任何 SKIP 步骤时最终退出码为 1"
      },
      "allow-external-plugins": {
        "kind": "flag",
        "description": "允许加载外部插件（有安全风险）"
      },
      "json": {
        "kind": "flag",
        "description": "capabilities/doctor 输出机器可读 JSON（stdout 纯净）"
      },
      "token": {
        "kind": "value",
        "description": "（已弃用）命令行传递授权令牌；推荐 SCENARIO_AUTH 环境变量",
        "aliases": [
          "authorization"
        ]
      }
    }
  }
}
