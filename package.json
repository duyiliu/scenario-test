{
  "name": "@yc_yzkj/scenario-test",
  "version": "0.8.0",
  "description": "Reusable browser and Node.js scenario testing library",
  "type": "module",
  "main": "dist/scenario-test.cjs",
  "module": "dist/scenario-test.esm.js",
  "browser": "dist/scenario-test.umd.js",
  "types": "dist/scenario-test.d.ts",
  "files": [
    "dist/scenario-test.umd.js",
    "dist/scenario-test.esm.js",
    "dist/scenario-test.cjs",
    "dist/scenario-test-cli.cjs",
    "dist/scenario-test.d.ts",
    "dist/scenario-test-capabilities.json",
    "scripts/install.ps1",
    "scripts/install.sh",
    "scripts/start-scenario-test.ps1"
  ],
  "bin": {
    "scenario-test": "dist/scenario-test-cli.cjs"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.js tests/*.unit.test.mjs",
    "test:coverage": "node --test --test-reporter=tap --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=90 --test-coverage-branches=80 tests/*.test.js tests/*.unit.test.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:ui-style": "node tests/ui-style.test.mjs",
    "test:all": "npm run test:unit && npm run test:browser && npm run test:ui-style",
    "check:eol": "node scripts/check-eol.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check": "npm run build && npm run test:all && npm run check:coverage",
    "check:all": "npm run check"
  },
  "dependencies": {
    "blueimp-md5": "2.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "esbuild": "0.25.8",
    "playwright": "1.55.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "brace-expansion": "^2.1.3"
  },
  "engines": {
    "node": ">=18"
  }
}
