{
  "description": "订单调整单服务的业务变异。每个变异都应被合格的场景套件杀死；存活说明场景没有验证对应业务结果。",
  "mutations": [
    {
      "id": "M1-drop-idempotency",
      "description": "移除幂等检查：同一 requestId 重复提交会落两条记录",
      "edits": [
        {
          "file": "src/main/java/com/example/order/OrderAdjustService.java",
          "find": [
            "        return adjustRepository.findByRequestId(request.getRequestId())",
            "                .orElseGet(() -> doCreate(request));"
          ],
          "replace": [
            "        return doCreate(request);"
          ]
        }
      ]
    },
    {
      "id": "M2-relax-quantity-limit",
      "description": "放宽可调上限判断：超出可调数量的请求会被受理",
      "edits": [
        {
          "file": "src/main/java/com/example/order/OrderAdjustService.java",
          "find": [
            "        if (request.getQuantity() > order.getAdjustableQuantity()) {"
          ],
          "replace": [
            "        if (request.getQuantity() > order.getAdjustableQuantity() + 100) {"
          ]
        }
      ]
    },
    {
      "id": "M3-invalid-quantity-writes-first",
      "description": "数量非法时先落单再拒绝：失败请求留下脏数据（同时移除 Bean Validation，否则请求到不了 Service）",
      "edits": [
        {
          "file": "src/main/java/com/example/order/OrderAdjustRequest.java",
          "find": [
            "    @Min(value = 1, message = \"调整数量必须大于 0\")"
          ],
          "replace": [
            ""
          ]
        },
        {
          "file": "src/main/java/com/example/order/OrderAdjustService.java",
          "find": [
            "        if (request.getQuantity() == null || request.getQuantity() <= 0) {",
            "            throw new BizException(ErrorCode.QUANTITY_INVALID);",
            "        }",
            "        if (request.getQuantity() > order.getAdjustableQuantity()) {",
            "            // 先校验后落单：此处抛出时库中不会留下任何调整单记录",
            "            throw new BizException(ErrorCode.ADJUST_QUANTITY_EXCEEDED);",
            "        }",
            "",
            "        OrderAdjust adjust = adjustRepository.save(new OrderAdjust(",
            "                null, order.getId(), request.getRequestId(), request.getQuantity(), OrderAdjustStatus.PENDING));"
          ],
          "replace": [
            "        if (request.getQuantity() > order.getAdjustableQuantity()) {",
            "            throw new BizException(ErrorCode.ADJUST_QUANTITY_EXCEEDED);",
            "        }",
            "",
            "        OrderAdjust adjust = adjustRepository.save(new OrderAdjust(",
            "                null, order.getId(), request.getRequestId(), request.getQuantity(), OrderAdjustStatus.PENDING));",
            "",
            "        if (request.getQuantity() == null || request.getQuantity() <= 0) {",
            "            throw new BizException(ErrorCode.QUANTITY_INVALID);",
            "        }"
          ]
        }
      ]
    },
    {
      "id": "M4-exceeded-writes-first",
      "description": "超限时先落单再拒绝：被拒的超限请求留下脏数据",
      "edits": [
        {
          "file": "src/main/java/com/example/order/OrderAdjustService.java",
          "find": [
            "        if (request.getQuantity() == null || request.getQuantity() <= 0) {",
            "            throw new BizException(ErrorCode.QUANTITY_INVALID);",
            "        }",
            "        if (request.getQuantity() > order.getAdjustableQuantity()) {",
            "            // 先校验后落单：此处抛出时库中不会留下任何调整单记录",
            "            throw new BizException(ErrorCode.ADJUST_QUANTITY_EXCEEDED);",
            "        }",
            "",
            "        OrderAdjust adjust = adjustRepository.save(new OrderAdjust(",
            "                null, order.getId(), request.getRequestId(), request.getQuantity(), OrderAdjustStatus.PENDING));"
          ],
          "replace": [
            "        if (request.getQuantity() == null || request.getQuantity() <= 0) {",
            "            throw new BizException(ErrorCode.QUANTITY_INVALID);",
            "        }",
            "",
            "        OrderAdjust adjust = adjustRepository.save(new OrderAdjust(",
            "                null, order.getId(), request.getRequestId(), request.getQuantity(), OrderAdjustStatus.PENDING));",
            "",
            "        if (request.getQuantity() > order.getAdjustableQuantity()) {",
            "            throw new BizException(ErrorCode.ADJUST_QUANTITY_EXCEEDED);",
            "        }"
          ]
        }
      ]
    },
    {
      "id": "M5-approve-ignores-status",
      "description": "审批不检查状态：已审批的调整单可以再次审批成功",
      "edits": [
        {
          "file": "src/main/java/com/example/order/OrderAdjustService.java",
          "find": [
            "        if (adjust.getStatus() != OrderAdjustStatus.PENDING) {",
            "            throw new BizException(ErrorCode.INVALID_STATUS_TRANSITION);",
            "        }"
          ],
          "replace": [
            "        if (false) {",
            "            throw new BizException(ErrorCode.INVALID_STATUS_TRANSITION);",
            "        }"
          ]
        }
      ]
    },
    {
      "id": "M6-list-ignores-order-filter",
      "description": "列表查询忽略 orderId：返回全部订单的调整单",
      "edits": [
        {
          "file": "src/main/java/com/example/order/OrderAdjustRepository.java",
          "find": [
            "                .filter(adjust -> orderId != null && orderId.equals(adjust.getOrderId()))"
          ],
          "replace": [
            "                .filter(adjust -> true)"
          ]
        }
      ]
    },
    {
      "id": "M7-wrong-error-code",
      "description": "超限返回错误码被换成数量非法（40001）",
      "edits": [
        {
          "file": "src/main/java/com/example/order/OrderAdjustService.java",
          "find": [
            "            throw new BizException(ErrorCode.ADJUST_QUANTITY_EXCEEDED);"
          ],
          "replace": [
            "            throw new BizException(ErrorCode.QUANTITY_INVALID);"
          ]
        }
      ]
    },
    {
      "id": "M8-wrong-quantity-persisted",
      "description": "落单时忽略请求数量，固定写入 1",
      "edits": [
        {
          "file": "src/main/java/com/example/order/OrderAdjustService.java",
          "find": [
            "        OrderAdjust adjust = adjustRepository.save(new OrderAdjust(",
            "                null, order.getId(), request.getRequestId(), request.getQuantity(), OrderAdjustStatus.PENDING));"
          ],
          "replace": [
            "        OrderAdjust adjust = adjustRepository.save(new OrderAdjust(",
            "                null, order.getId(), request.getRequestId(), 1, OrderAdjustStatus.PENDING));"
          ]
        }
      ]
    },
    {
      "id": "M9-detail-always-pending",
      "description": "详情接口永远返回 PENDING 状态（读到的状态与真实状态不一致）",
      "edits": [
        {
          "file": "src/main/java/com/example/order/OrderAdjustService.java",
          "find": [
            "    public OrderAdjust get(long id) {",
            "        return adjustRepository.findById(id)",
            "                .orElseThrow(() -> new BizException(ErrorCode.ADJUST_NOT_FOUND));",
            "    }"
          ],
          "replace": [
            "    public OrderAdjust get(long id) {",
            "        OrderAdjust found = adjustRepository.findById(id)",
            "                .orElseThrow(() -> new BizException(ErrorCode.ADJUST_NOT_FOUND));",
            "        return new OrderAdjust(found.getId(), found.getOrderId(), found.getRequestId(),",
            "                found.getQuantity(), OrderAdjustStatus.PENDING);",
            "    }"
          ]
        }
      ]
    }
  ]
}
